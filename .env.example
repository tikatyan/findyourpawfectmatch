# PostHog product analytics (client-side, public keys)
# Get these from PostHog -> Settings -> Project.
# The project API key starts with "phc_" and is safe to expose in the browser.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here
# Use https://eu.i.posthog.com if your PostHog project is in the EU region.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
